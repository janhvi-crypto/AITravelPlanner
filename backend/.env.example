# =============================================================================
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env to git.
# Full beginner guide: docs/SUPABASE_AND_GEMINI_SETUP.md
# =============================================================================

PORT=5000
CLIENT_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key (Auth signup/login)
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# service_role secret (server-only trip CRUD — keep private!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_KEY=your-service-role-secret-key

# false = real Supabase only (recommended once keys are set)
# true  = allow fake login when Supabase keys are missing
ALLOW_DEMO_AUTH=false

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Optional for later ---
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
AI_PROVIDER=gemini
API_KEY=
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
